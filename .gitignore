.DS_Store
.idea/
.vscode/
*.swp
*.swo
._*

# Temporary directories and editor backup files.
/tmp/
/temp/
/backend/tmp/
/backend/temp/
/frontend/tmp/
/frontend/temp/
*.tmp
*.temp
*.bak
*~

# Preserve source/docs/fixture directories named like scientific artifact folders.
# These directory exceptions do not unignore weights, caches, or credentials.
!/**/src/**/data/
!/**/src/**/datasets/
!/**/src/**/models/
!/**/src/**/weights/
!/**/src/**/outputs/
!/docs/**/data/
!/docs/**/datasets/
!/docs/**/models/
!/docs/**/weights/
!/docs/**/outputs/
!/backend/tests/fixtures/**/data/
!/backend/tests/fixtures/**/datasets/
!/backend/tests/fixtures/**/models/
!/backend/tests/fixtures/**/weights/
!/backend/tests/fixtures/**/outputs/

# Only small, synthetic, license-compatible molecular fixtures belong here.
# Gitignore cannot enforce size or provenance; review fixtures before committing.
# Match non-hidden basenames so .env.* credentials remain ignored.
!/backend/tests/fixtures/**/[!.]*.pdb
!/backend/tests/fixtures/**/[!.]*.cif
!/backend/tests/fixtures/**/[!.]*.mmcif
!/backend/tests/fixtures/**/[!.]*.pqr
!/backend/tests/fixtures/**/[!.]*.sdf
!/backend/tests/fixtures/**/[!.]*.mol
!/backend/tests/fixtures/**/[!.]*.mol2
!/backend/tests/fixtures/**/[!.]*.xyz
!/backend/tests/fixtures/**/[!.]*.bcif
!/backend/tests/fixtures/**/[!.]*.mmtf
!/backend/tests/fixtures/**/[!.]*.pdb.gz
!/backend/tests/fixtures/**/[!.]*.cif.gz
!/backend/tests/fixtures/**/[!.]*.mmcif.gz
!/backend/tests/fixtures/**/[!.]*.sdf.gz

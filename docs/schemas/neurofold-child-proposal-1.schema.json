        "query_sequence_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "enum": [
            "neurofold-prediction/1"
          ]
        },
        "transformation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "mode",
        "artifacts",
        "reason",
        "query_sequence_hash",
        "transformation"
      ],
      "type": "object"
    },
    "AuxiliaryProvenance": {
      "additionalProperties": false,
      "properties": {
        "obtained_at": {
          "anyOf": [
            {
              "type": "string"
            },

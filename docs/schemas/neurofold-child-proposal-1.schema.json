    "Metadata": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "reason": {
                "pattern": "\\S",
                "type": "string"
              },
              "value": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "state": {
                "const": "present"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "present",
            "unavailable",
            "not_applicable"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "value",
        "reason"
      ],
      "type": "object"
    },

    "ContentHash": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "sha256"
          ]
        },
        "encoding": {
          "enum": [
            "raw-bytes/1",
            "sequence-ascii/1",
            "neurofold-json/1"
          ],
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "encoding",
        "algorithm"
      ],
      "type": "object"
    },

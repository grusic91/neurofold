{
  "$comment": "Shape schema; strict codecs and semantic validation required.",
  "$defs": {
    "ArtifactDescriptor": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "byte_size": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "evidence": {
          "enum": [
            "experimental",
            "predicted",
            "synthetic"
          ],
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "parents": {
          "items": {
            "$ref": "#/$defs/ContentHash"
          },
          "type": "array"
        },
        "record_kind": {
          "enum": [
            "artifact"
          ]
        },
        "rights": {
          "$ref": "#/$defs/ArtifactRights"
        },
        "schema_version": {
          "enum": [
            "neurofold-research/1"
          ]
        },
        "transformation": {
          "$ref": "#/$defs/Metadata"
        }
      },
      "required": [
        "schema_version",
        "artifact_id",
        "content_hash",
        "byte_size",
        "media_type",
        "evidence",
        "rights",
        "parents",
        "transformation",
        "record_kind"
      ],
      "type": "object"
    },
    "ArtifactRights": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Metadata"
        },
        "basis": {
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/Metadata"
        },
        "redistribution": {
          "enum": [
            "allowed",
            "prohibited",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "license",
        "attribution",
        "redistribution",
        "basis"
      ],
      "type": "object"
    },

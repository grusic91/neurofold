# Used only by the Vite development server. Docker Compose overrides this value.
API_PROXY_TARGET=http://127.0.0.1:8000
# VITE_* variables become public browser code. Never put secrets in them.
# Optional public browser API base; default /api. Use an explicit HTTP(S) origin
# only with a deliberately configured reverse proxy/CORS deployment.
VITE_API_BASE=/api
